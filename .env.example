# Replace with your private 6-digit PIN before exposing the app.
ADMIN_PIN=SET_YOUR_PRIVATE_SIX_DIGIT_PIN
# Required for login sessions; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# Set to the mounted persistent-storage directory on your host, if applicable.
# DATA_DIR=/var/data
